# Release signing for :app (audit S8). Copy to `keystore.properties` at the
# repo root and fill in; that file, *.jks and *.keystore are gitignored and
# must never be committed. The same four values can be given as environment
# variables instead — DIAPILOT_KEYSTORE_FILE, DIAPILOT_KEYSTORE_PASSWORD,
# DIAPILOT_KEY_ALIAS, DIAPILOT_KEY_PASSWORD — which is what CI does; the
# environment wins when both are present.
#
# Create the keystore once (keep it and its passwords in a password manager;
# losing it means users cannot update in place — see README "Building"):
#   keytool -genkeypair -v -keystore diapilot-release.jks -storetype PKCS12 \
#     -alias diapilot -keyalg RSA -keysize 4096 -validity 10000
#
# A relative storeFile is resolved against the repo root.
storeFile=diapilot-release.jks
storePassword=changeit
keyAlias=diapilot
keyPassword=changeit
