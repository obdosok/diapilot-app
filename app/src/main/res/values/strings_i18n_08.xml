    <!-- HypoAlertNotifier.kt -->
    <string name="hypo_alert_notifier_watch_test_channel_name">Watch test</string>
    <string name="hypo_alert_notifier_watch_test_channel_desc">Checks notification mirroring to the watch</string>
    <!-- %1$s: HH:mm:ss timestamp. -->
    <string name="hypo_alert_notifier_watch_test_title">⌚ Watch signal test · %1$s</string>
    <string name="hypo_alert_notifier_watch_test_text">If Zepp mirrors notifications, the watch will vibrate now.</string>
    <!-- %1$s: the user's hypo treatment plan text. -->
    <string name="hypo_alert_notifier_protocol_line">Your plan: %1$s</string>
    <string name="hypo_alert_notifier_protocol_default">Check your glucose and follow your hypo treatment plan.</string>
    <!-- %1$s: threshold glucose; %2$s: crossing time; %3$s: minimum glucose; %4$s: protocol line. -->
    <string name="hypo_alert_notifier_predict_text">Forecast: below %1$s by %2$s, minimum ~%3$s. %4$s</string>
    <string name="hypo_alert_notifier_artifact_title">⚠ Critically low or sensor fault</string>
    <!-- %1$s: glucose value. -->
    <string name="hypo_alert_notifier_artifact_text">Value %1$s. This may be a sensor artifact — check with a meter URGENTLY and follow your plan. Entering a meter reading will refine the calibration.</string>
    <!-- %1$d: minutes observed; %2$d: minutes since the episode started. -->
    <string name="hypo_alert_notifier_persistent_title_blind">⚠ Prolonged low — seen %1$d of %2$d min</string>
    <!-- %1$d: minutes low. -->
    <string name="hypo_alert_notifier_persistent_title">⚠ Prolonged low — %1$d min</string>
    <!-- %1$s: threshold glucose; %2$s: current glucose; %3$d: minutes without reliable data; %4$s: protocol line. -->
    <string name="hypo_alert_notifier_persistent_text_blind">Glucose has stayed below %1$s for a while (%2$s). %3$d min without reliable data isn\'t counted. If treatment isn\'t helping, follow your plan. %4$s</string>
    <!-- %1$s: threshold glucose; %2$s: current glucose; %3$s: protocol line. -->
    <string name="hypo_alert_notifier_persistent_text">Glucose has stayed below %1$s for a while (%2$s). If treatment isn\'t helping, follow your plan. %3$s</string>
    <!-- %1$s: current glucose. -->
    <string name="hypo_alert_notifier_low_title">⚠ Low right now — %1$s</string>
    <!-- %1$s: threshold glucose; %2$s: protocol line. -->
    <string name="hypo_alert_notifier_low_text">Glucose is below %1$s. %2$s</string>
    <!-- %1$.0f: minutes until the predicted low. -->
    <string name="hypo_alert_notifier_predict_title">⚠ Possible low in ~%1$.0f min</string>
    <string name="hypo_alert_notifier_sensor_check_title">🔎 Sensor reading looks implausibly low</string>
    <!-- %1$s: glucose value. -->
    <string name="hypo_alert_notifier_sensor_check_text">Value %1$s looks like a sensor fault (compression/EOL overnight). Check with a meter and trust how you feel — a real mild low can hide underneath this. Entering a meter reading will refine the calibration.</string>
    <string name="hypo_alert_notifier_channel_name">Hypo forecast</string>
    <string name="hypo_alert_notifier_channel_desc">Early warning: the model sees a low ahead</string>
    <!-- %1$d: minutes above the sustained-high threshold. -->
    <string name="hypo_alert_notifier_sustained_high_title">↑ High for %1$d min</string>
    <!-- %1$s: threshold glucose; %2$s: peak glucose. -->
    <string name="hypo_alert_notifier_sustained_high_text">Above %1$s continuously, peak %2$s. Follow your plan.</string>
    <!-- %1$.0f: minutes until the predicted rise above range. -->
    <string name="hypo_alert_notifier_hyper_predict_title">↗ Possible rise above range in ~%1$.0f min</string>
    <!-- %1$s: ceiling glucose; %2$s: crossing time; %3$s: peak glucose. -->
    <string name="hypo_alert_notifier_hyper_predict_text">Forecast: above %1$s by %2$s, peak ~%3$s. Check and follow your plan.</string>
    <string name="hypo_alert_notifier_hyper_channel_name">High glucose forecast</string>
    <string name="hypo_alert_notifier_hyper_channel_desc">Early warning about a rise above range</string>

