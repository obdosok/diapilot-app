    <string name="analysis_overview_screen_hint_absorption">Log protein/fat, or confirm the photo breakdown, before evaluating the result.</string>
    <string name="analysis_overview_screen_hint_duration_absorption">Enter the meal duration in the food clarification.</string>
    <string name="analysis_overview_screen_hint_alcohol_background">Note alcohol in the meal entry.</string>
