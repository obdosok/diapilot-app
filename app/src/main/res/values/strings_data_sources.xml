    <!-- One line per row: what breaks while it is red. -->
    <string name="data_sources_row_xdrip_app_why">xDrip+ owns the sensor. Without it the app receives no glucose at all.</string>
    <string name="data_sources_row_xdrip_broadcast_why">The main glucose feed. When it stops, the chart, the status and the alerts stop with it.</string>
    <string name="data_sources_row_xdrip_web_why">Doses and missed readings are fetched over this service. Without it insulin is absent and gaps in the chart stay empty.</string>
    <string name="data_sources_row_nightscout_why">A second glucose source. Without one, a break in xDrip leaves the app with nothing to read.</string>
    <string name="data_sources_row_oop2_why">The per-minute glucose stream. Without it no alert can fire at all — the hypo alert and rapid-fall detection both run on this beat; the widget falls back to its 30-minute refresh.</string>
    <string name="data_sources_row_own_ble_why">This app\'s own link to the sensor. While it is off, glucose comes from xDrip only.</string>
    <string name="data_sources_row_battery_why">Under battery optimization Android puts the app to sleep, and collection sleeps with it — usually overnight.</string>
    <string name="data_sources_row_notifications_why">Blocked notifications mean the low-glucose warning cannot reach you.</string>
    <string name="data_sources_row_exact_alarms_why">Without exact alarms the night-time checks are deferred by the system and a warning can arrive late.</string>
    <string name="data_sources_row_collector_service_why">The service that listens for readings. Stopped, nothing is collected while the app is closed.</string>
    <string name="data_sources_row_health_connect_why">Heart rate, sleep and steps arrive from here. Without them the model cannot see activity.</string>
    <string name="data_sources_row_overlay_why">Shows glucose over the lock screen. Off, the app has to be opened to look.</string>
    <string name="data_sources_row_nfc_why">NFC reads the insulin pen\'s dose log.</string>
    <string name="data_sources_row_nfc_why_sensor_direct">NFC reads the insulin pen\'s dose log and scans the sensor.</string>

