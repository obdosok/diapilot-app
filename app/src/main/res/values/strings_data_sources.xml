    <string name="data_sources_advice_install_xdrip">Install xDrip+ (it is not on Google Play), then turn on Settings → Inter-app settings → Broadcast locally.</string>
    <string name="data_sources_advice_needs_xdrip">Install xDrip+ first — the rest of this chain reads from it.</string>
    <string name="data_sources_advice_nightscout">This build has no Nightscout source yet; it is planned for the next release.</string>
    <string name="data_sources_advice_oop2">Install OOPAlgorithm2 and let xDrip+ hand it the sensor packet.</string>
    <string name="data_sources_advice_own_ble">Hold the phone to the sensor to scan it over NFC, and check that Bluetooth is on.</string>
    <string name="data_sources_advice_health_connect">Health Connect is not on this phone. Install it to read heart rate, sleep and steps.</string>
