<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Loopback poll of the xDrip local web service (127.0.0.1:17580) only; no cloud. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- "Looks like you ate" labeling prompts (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- AlarmPlayer vibrates directly (channel vibration alone is swallowed on
         silent); without this the direct Vibrator call is a silent no-op. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- BG overlay drawn over the lock screen (xDrip-style glance). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Background collection: implicit xDrip broadcasts only reach a
         dynamically-registered receiver, which a foreground service keeps alive.
         We deliberately do NOT use xDrip's Identify receiver — other apps on
         this phone (OOPAlgorithm2, WatchDrip) consume the same broadcast. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- BLE stall recovery in Doze. A foreground service does NOT keep the CPU
         awake: in deep sleep Handler.postDelayed (uptimeMillis) never fires, so
         the reconnect/watchdog froze and a night stall stood ~37 min until a
         Doze maintenance window. An RTC_WAKEUP allow-while-idle alarm is the
         only thing that fires; WAKE_LOCK then keeps the CPU up long enough for
         the connect→login→first-packet handshake to finish. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Doze throttles allow-while-idle alarms to ~1/9min unless the alarm is
         exact; a night hypo alert must not wait that long. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Physiology from the on-device Health Connect hub (fed by Zepp). -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <!-- Steps: activity detection (calm walks the pulse misses). Must be
         DECLARED here or Health Connect never offers the toggle. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />

    <!-- Android 11+ package visibility: we receive broadcasts from xDrip. -->
    <queries>
        <package android:name="com.eveningoutpost.dexdrip" />
    </queries>

    <!-- No system backup or device transfer: the preferences hold credentials
         and the database is medical data; the app has its own explicit backup.
         allowBackup="false" covers cloud backup on all API levels and device
         transfer below API 31; data_extraction_rules.xml covers device transfer
         on API 31+, where allowBackup no longer does. BackupPolicyTest pins it. -->
    <application
        android:name=".DiaPilotApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DiaPilot">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.DiaPilot"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Health Connect permission rationale entry point. -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name=".collect.XdripBgReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.eveningoutpost.dexdrip.BgEstimate" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".collect.LabelActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".collect.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".collect.CollectorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Continuous CGM data collection from the local xDrip broadcast" />
        </service>
            <receiver
            android:name=".widget.BgWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_bg_info" />
        </receiver>

        <!-- Per-app language below API 33: AppCompat stores the choice made in
             Settings -> Language and restores it on the next start. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>
