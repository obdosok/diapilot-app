# Private medical data. Glucose exports, device dumps, settings exports and
# companion-server state carry real patient data or live credentials, so none
# of them may ever be committed.
*.sqlite
*.sqlite3
*.db
export*.db
snap*.json
diag*.json
prefs*.xml
server/data/
/data/
local/
.env
.env.*
*.csv

# Release signing (audit S8). The keystore and its passwords are read from
# DIAPILOT_KEYSTORE_* environment variables or from keystore.properties at
# the repo root (see keystore.properties.example); neither may be committed.
keystore.properties
*.jks
*.keystore
